void draw_instrument_label(int type, int y) {
    char letter;
    switch (type) {
        case 1: letter = 'P'; break; 
        case 2: letter = 'V'; break; 
        case 3: letter = 'H'; break; 
        case 4: letter = 'S'; break; 
        case 5: letter = 'B'; break; 
        default: return;
    }
    draw_char(letter, 8, y, 1, 0xFFFF);
}

double find_seconds_per_bar(int bpm) { return 60.0 /bpm; }

void count_bars(int bpm, int bars, int continuous, int *stop) {
    double seconds = bars * find_seconds_per_bar(bpm);
    unsigned int counter_start_value = (unsigned int)(TIMER_FREQ * seconds);
    TIMER_CTRL = 0;
    TIMER_STATUS = 0;
    TIMER_LOW  = counter_start_value & 0xFFFF;
    TIMER_HIGH = (counter_start_value >> 16) & 0xFFFF;
    int begin = 0b100; 
    if (continuous == 1) begin = 0b110; 
    TIMER_CTRL = begin;
    if (continuous == 1) {
        while (*stop == 0) {
            if ((TIMER_STATUS & 0x1) != 0) TIMER_STATUS = 0; 
        }
        TIMER_CTRL = 0; 
    } else {
        while ((TIMER_STATUS & 0x1) == 0);
        TIMER_STATUS = 0;
    }
}

void play_audio(const int audio_sample[], int num_of_samples) {
    for (int i = 0; i < num_of_samples; i++) {
        int space = 0;
        while (space == 0) {
            int left = (AUDIO_FIFOSPACE >> 24) & 0xFF;
            int right = (AUDIO_FIFOSPACE >> 16) & 0xFF;
            space = (left < right) ? left : right;
        }
        AUDIO_LEFT  = audio_sample[i] * VOLUME_MULTIPLIER;
        AUDIO_RIGHT = audio_sample[i] * VOLUME_MULTIPLIER;
    }
}

void plot_pixel(int x, int y, short int line_color){
    volatile short int *one_pixel_address = (short int*)(pixel_buffer_start + (y << 10) + (x << 1));
    *one_pixel_address = line_color;
}

short int get_pixel(int x, int y) {
    volatile short int *one_pixel_address = (short int*)(pixel_buffer_start + (y << 10) + (x << 1));
    return *one_pixel_address; 
}

