void init_mouse() {
    volatile int *ps2_ptr = (int *)PS2_BASE;
    clear_ps2();
    *ps2_ptr = 0xFF;
    clear_ps2();
    *ps2_ptr = 0xF4;
    clear_ps2();
}

void clear_ps2() {
    volatile int *ps2_ptr = (int *)PS2_BASE;
    while (*ps2_ptr & 0x8000) (void)*ps2_ptr; 
}

void wait_for_vsync() {
    volatile int * pixel_ctrl_ptr = (int *)0xFF203020;
    *pixel_ctrl_ptr = 1;
    volatile int * status_reg = pixel_ctrl_ptr + 3;
    while ((*status_reg & 0x1) != 0) {
        update_hardware();
    }
}
