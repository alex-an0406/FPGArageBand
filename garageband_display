// ==========================================
// MAIN FUNCTION
// ==========================================
int main (void) {
    volatile int * pixel_ctrl_ptr = (int *)FRAME_BASE;
    
    *(pixel_ctrl_ptr + 1) = (int) &Buffer1;
    wait_for_vsync(); 
    
    pixel_buffer_start = (int) &Buffer1;

    clear_screen(); 
		
    int recordActive = 0;
    int chooseActive = 0;
    int stop = 0;
    int *stop_ptr = &stop;

    AUDIO_CTRL = 0xC; 
    AUDIO_CTRL = 0x0;

    for (int i = 0; i < MAX_INSTRUMENTS; i++) {
        track_pos[i] = -1;
    }

    sample_lengths[3] = hihat_samples_n;
    sample_lengths[4] = snare_samples_n;
    sample_lengths[5] = bass_samples_n;

    draw_main_screen(recordActive, chooseActive);
    
    init_mouse();
    
    cache_cursor_bg(mouseX, mouseY);
    draw_cursor(mouseX, mouseY, 0xFFFF);

    int prevMouseX = 160, prevMouseY = 120; 

    while (1) {
        
        // 1. Process edge-detected clicks from the hardware poller
        if (global_clicked) {
            int cx = global_clickX;
            int cy = global_clickY;
            global_clicked = 0;

            if (chooseActive) {
                int selected = 0;
                if (cx > 108 && cx < 158 && cy > 74 && cy < 123) {
                    choose_piano(); selected = 1;
                } else if (cx > 161 && cx < 211 && cy > 74 && cy < 123) {
                    choose_vocal(); selected = 1;
                } else if (cx > 82 && cx < 132 && cy > 129 && cy < 178) {
                    choose_hihat(); selected = 1;
                } else if (cx > 135 && cx < 185 && cy > 129 && cy < 178) {
                    choose_snare(); selected = 1;
                } else if (cx > 188 && cx < 238 && cy > 129 && cy < 178) {
                    choose_bass(); selected = 1;
                } else if (cx > 0 && cx < 21 && cy > new_instrument_location_y1 && cy < new_instrument_location_y2) {	
                    selected = 1;
                }
                
                if (selected) {
                    chooseActive = 0;
                    erase_cursor(mouseX, mouseY);
                    erase_menu();
                    update_left_menu();
                    cache_cursor_bg(mouseX, mouseY);
                    draw_cursor(mouseX, mouseY, 0xFFFF);
                }
            } else {
                if (cx > 149 && cx < 169 && cy > 5 && cy < 16) {
                    // Toggle play — do NOT reset tick or sample_counter so resume works correctly
                    playActive = !playActive;
                    erase_cursor(mouseX, mouseY);
                    if (playActive) draw_play_button_green();
                    else draw_play_button_gray();
                    cache_cursor_bg(mouseX, mouseY);
                    draw_cursor(mouseX, mouseY, 0xFFFF);
                    
                } else if (cx > 169 && cx < 184 && cy > 5 && cy < 16) {
                    recordActive = !recordActive;
                    erase_cursor(mouseX, mouseY);
                    if (recordActive) {
                        fill_area(170, 184, 5, 16, 0xFC10); 
                    } else {
                        fill_area(170, 184, 5, 16, 0x2104);
                    }
                    draw_circle(177, 10, 3, 0xF800);
                    fill_shape(177 - 3, 10 - 3, 177 + 3, 10 + 3, 0xF800, 0xF800);
                    cache_cursor_bg(mouseX, mouseY);
                    draw_cursor(mouseX, mouseY, 0xFFFF);
                    
                    if (recordActive) {
                        play_audio(metronome_sample, METRONOME_NUM_SAMPLES);
                        count_bars(beats_per_minute, 12, 0, stop_ptr);
                        
                        recordActive = 0;
                        erase_cursor(mouseX, mouseY);
                        fill_area(170, 184, 5, 16, 0x2104); 
                        draw_circle(177, 10, 3, 0xF800);
                        fill_shape(177 - 3, 10 - 3, 177 + 3, 10 + 3, 0xF800, 0xF800);
                        cache_cursor_bg(mouseX, mouseY);
                        draw_cursor(mouseX, mouseY, 0xFFFF);
                    }
                    
                } else if (cx > 0 && cx < 21 && cy > new_instrument_location_y1 && cy < new_instrument_location_y2) {	
                    chooseActive = 1;
                    erase_cursor(mouseX, mouseY);
                    choose_instrument();
                    cache_cursor_bg(mouseX, mouseY);
                    draw_cursor(mouseX, mouseY, 0xFFFF);
                    
                } else if (cx > 21 && cx < 319 && cy > 29) {
                    int row = (cy - 30) / 20;

                    if (row < MAX_INSTRUMENTS && row < instrument_count && instrument_types[row] > 2) {
                        int col = -1;
                        for (int i = 0; i < NUM_STEPS; i++) {
                            if (cx >= step_x_bounds[i] && cx < step_x_bounds[i+1]) {
                                col = i; break;
                            }
                        }

                        if (col != -1) {
                            sequencer_grid[row][col] = !sequencer_grid[row][col];
                            
                            int x_start = step_x_bounds[col] + 1;
                            int x_end   = step_x_bounds[col + 1] - 1;
                            int y_start = 30 + (row * 20); 
                            int y_end   = y_start + 18; 
                            
                            if (y_end < 240) {
                                erase_cursor(mouseX, mouseY);
                                
                                if (sequencer_grid[row][col] == 1) {
                                    fill_area(x_start, x_end, y_start, y_end, 0x07E0); 
                                    track_pos[row] = 0; 
                                } else {
                                    fill_area(x_start, x_end, y_start, y_end, 0x0841); 
                                }
                                cache_cursor_bg(mouseX, mouseY);
                                draw_cursor(mouseX, mouseY, 0xFFFF);
                            }
                        }
                    }
                }
            }
        }
        
        // 2. Mouse Cursor Delta Rendering
        if (mouseX != prevMouseX || mouseY != prevMouseY) {
            erase_cursor(prevMouseX, prevMouseY);
            cache_cursor_bg(mouseX, mouseY);
            draw_cursor(mouseX, mouseY, 0xFFFF);
            
            prevMouseX = mouseX;
            prevMouseY = mouseY;
        }

        // 3. Playhead Delta Rendering
        if (last_drawn_tick != current_tick) {
            int ph_x = step_x_bounds[current_tick] + (step_x_bounds[current_tick + 1] - step_x_bounds[current_tick]) / 2;
            int cursor_near = (mouseX >= ph_x - 2 && mouseX <= ph_x + 2 && mouseY >= 29 && mouseY <= 239);

            if (cursor_near) erase_cursor(mouseX, mouseY);
            if (last_drawn_tick >= 0) erase_playhead(last_drawn_tick);
            if (playActive) draw_playhead(current_tick, 0xFFFF);
            last_drawn_tick = current_tick;
            if (cursor_near) {
                cache_cursor_bg(mouseX, mouseY);
                draw_cursor(mouseX, mouseY, 0xFFFF);
            }
        }

        // 4. Continuously run the hardware 
        update_hardware();
    }
}

// ==========================================
// Hardware Synchronization Functions
// ==========================================
void update_hardware() {
    update_audio();
    poll_mouse();
}

void update_audio() {
    int left_space = (AUDIO_FIFOSPACE >> 24) & 0xFF;
    int right_space = (AUDIO_FIFOSPACE >> 16) & 0xFF;
    int space = (left_space < right_space) ? left_space : right_space;
    
    while (space > 0) {
        long long mixed_sample = 0; 

        for (int i = 0; i < instrument_count; i++) {
            int type = instrument_types[i];

            if (track_pos[i] != -1 && sample_lengths[type] > 0) {
                mixed_sample += (sample_pointers[type][track_pos[i]] * VOLUME_MULTIPLIER); 
                track_pos[i]++;
                
                if (track_pos[i] >= sample_lengths[type]) track_pos[i] = -1; 
            }
        }

        if (mixed_sample > 2147483647LL) mixed_sample = 2147483647LL;
        if (mixed_sample < -2147483648LL) mixed_sample = -2147483648LL;

        AUDIO_LEFT = (int)mixed_sample;
        AUDIO_RIGHT = (int)mixed_sample;
        
        space--;

        if (playActive) {
            sample_counter++;
            int samples_per_step = 120000 / beats_per_minute;
            
            if (sample_counter >= samples_per_step) { 
                sample_counter = 0;
                current_tick = (current_tick + 1) % NUM_STEPS;
                for (int i = 0; i < instrument_count; i++) {
                    if (sequencer_grid[i][current_tick]) track_pos[i] = 0;
                }
            }
        }
    }
}

void poll_mouse() {
    volatile int *ps2_ptr = (int *)PS2_BASE;
    int data;
    static int prev_btn = 0;
    
    while (1) {
        data = *ps2_ptr;
        if ((data & 0x8000) == 0) return;  

        int byte1 = data & 0xFF;
        if(!(byte1 & 0x08)) continue;

        do { data = *ps2_ptr; } while ((data & 0x8000) == 0);
        int byte2 = data & 0xFF;

        do { data = *ps2_ptr; } while ((data & 0x8000) == 0);
        int byte3 = data & 0xFF;

        int dx = (int)(signed char)byte2;
        int dy = (int)(signed char)byte3;

        if (byte1 & 0x40) dx = 0;
        if (byte1 & 0x80) dy = 0;

        dx = dx / 5;
        dy = dy / 5;

        mouseX += dx;
        mouseY -= dy;

        if (mouseX < 0)   mouseX = 0;
        if (mouseX > 319) mouseX = 319;
        if (mouseY < 0)   mouseY = 0;
        if (mouseY > 239) mouseY = 239;

        int current_btn = byte1 & 0x01;
        if (current_btn && !prev_btn) {
            global_clicked = 1;
            global_clickX = mouseX;
            global_clickY = mouseY;
        }
        prev_btn = current_btn;
    }
}

// ==========================================
// Playhead Functions
// ==========================================

// Draws a white vertical line through the centre of the given step column
void draw_playhead(int tick, short int color) {
    int x = step_x_bounds[tick] + (step_x_bounds[tick + 1] - step_x_bounds[tick]) / 2;
    for (int y = 29; y < 240; y++) {
        plot_pixel(x, y, color);
    }
}

// Erases the playhead by restoring each pixel to its correct background color.
// Starts from y=30 to avoid the off-by-one at the grid boundary.
void erase_playhead(int tick) {
    int x = step_x_bounds[tick] + (step_x_bounds[tick + 1] - step_x_bounds[tick]) / 2;
    for (int y = 29; y < 240; y++) {
        short int restore_color = 0x0841;
        if (y >= 30) {
            int row = (y - 30) / 20;
            if (row >= 0 && row < instrument_count && sequencer_grid[row][tick] == 1) {
                restore_color = 0x07E0;
            }
        }
        plot_pixel(x, y, restore_color);
    }
}

// ==========================================
// Drawing Functions
// ==========================================
void cache_cursor_bg(int x, int y) {
    if (x + 1 < 320 && y < 240 && x - 1 >= 0 && y - 1 >= 0) {
        cursor_bg[0] = get_pixel(x, y);
        cursor_bg[1] = get_pixel(x + 1, y);
        cursor_bg[2] = get_pixel(x - 1, y);
        cursor_bg[3] = get_pixel(x, y + 1);
        cursor_bg[4] = get_pixel(x, y - 1);
    }
}

void erase_cursor(int x, int y) {
    if (x + 1 < 320 && y < 240 && x - 1 >= 0 && y - 1 >= 0) {
        plot_pixel(x, y, cursor_bg[0]);
        plot_pixel(x + 1, y, cursor_bg[1]);
        plot_pixel(x - 1, y, cursor_bg[2]);
        plot_pixel(x, y + 1, cursor_bg[3]);
        plot_pixel(x, y - 1, cursor_bg[4]);
    }
}

void draw_cursor(int x, int y, short int color) {
	if (x + 1 < 320 && y < 240 && x - 1 >= 0 && y - 1 >= 0) {
	    plot_pixel(x, y, color);
		plot_pixel(x + 1, y, color);
		plot_pixel(x - 1, y, color);
		plot_pixel(x, y + 1, color);
		plot_pixel(x, y - 1, color);
	}
}

void erase_menu() {
    fill_area(70, 250, 50, 190, 0x0841);

    int major_lines[] = {96, 133, 170, 207, 244};
    for (int i=0; i<5; i++) draw_line(major_lines[i], 50, major_lines[i], 190, 0x2104);

    int minor_lines[] = {77, 86, 105, 114, 123, 142, 151, 160, 179, 188, 197, 216, 225, 234};
    for (int i=0; i<14; i++) draw_line(minor_lines[i], 50, minor_lines[i], 190, 0x1082);

    for (int row = 0; row < instrument_count; row++) {
        for (int col = 0; col < NUM_STEPS; col++) {
            if (sequencer_grid[row][col] == 1) {
                int x_start = step_x_bounds[col] + 1;
                int x_end   = step_x_bounds[col + 1] - 1;
                int y_start = 30 + (row * 20); 
                int y_end   = y_start + 18; 
                if (x_end >= 70 && x_start <= 250 && y_end >= 50 && y_start <= 190) {
                    fill_area(x_start, x_end, y_start, y_end, 0x07E0); 
                }
            }
        }
    }
}

